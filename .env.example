# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/velnox?sslmode=require

# Google OAuth (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=[redacted]

# JWT
JWT_SECRET=[redacted]

# Cloudflare R2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=[redacted]
R2_SECRET_ACCESS_KEY=[redacted]
R2_BUCKET=your-bucket-name
R2_PUBLIC_DOMAIN=https://pub-xxx.r2.dev

# Server
PORT=3001
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ─── Cloudflare Turnstile (bot protection) ───────────────────────────────────
# PUBLIC key — ships in the frontend bundle. Set it on each Vercel project
# (VelShop, VelSeller, VelCenter): VITE_TURNSTILE_SITE_KEY
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# SECRET key — BACKEND ONLY (Render). Never put this in a Vercel env or the
# client bundle. Without it, every login/register/OAuth start fails closed in
# production (that is deliberate).
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Hosts the challenge is allowed to have been solved on, comma separated.
# Optional: when empty, the hosts of CORS_ORIGINS and VITE_*_URL are used.
# Example: velnox-shop.vercel.app,velnox-seller.vercel.app,velnox-center.vercel.app
TURNSTILE_HOSTNAMES=

# Optional: tighten the siteverify round-trip budget (default 5000 ms).
TURNSTILE_TIMEOUT_MS=5000

# ─── Pre-authentication proof (Google OAuth gate) ────────────────────────────
# Signs the short-lived one-time cookie that proves the challenge was solved
# before /auth/google may start. Optional: falls back to OAUTH_STATE_SECRET,
# then JWT_SECRET.
PREAUTH_PROOF_SECRET=
