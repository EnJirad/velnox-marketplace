{
  "name": "velnox-marketplace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "backend"
  ],
  "scripts": {
    "dev:velshop": "bun --filter @velnox/velshop dev",
    "dev:velseller": "bun --filter @velnox/velseller dev",
    "dev:velcenter": "bun --filter @velnox/velcenter dev",
    "dev:velnox": "bun --filter @velnox/velnox dev",
    "build:velshop": "bun --filter @velnox/velshop build",
    "build:velseller": "bun --filter @velnox/velseller build",
    "build:velcenter": "bun --filter @velnox/velcenter build",
    "build:velnox": "bun --filter @velnox/velnox build",
    "build:apps": "bun --filter '@velnox/velshop' build && bun --filter '@velnox/velseller' build && bun --filter '@velnox/velcenter' build && bun --filter '@velnox/velnox' build",
    "api:dev": "bun --filter @velnox/backend dev",
    "api:start": "bun --filter @velnox/backend start",
    "db:migrate": "node --experimental-strip-types database/migrate.ts up",
    "db:status": "node --experimental-strip-types database/migrate.ts status",
    "db:check": "node --experimental-strip-types database/migrate.ts check-files",
    "db:verify": "bash db/verify-reconciler.sh",
    "db:smoke": "echo 'DB smoke test placeholder'",
    "db:consistency": "echo 'DB consistency check placeholder'",
    "typecheck": "bun --filter '@velnox/velshop' typecheck && bun --filter '@velnox/velseller' typecheck && bun --filter '@velnox/velcenter' typecheck && bun --filter '@velnox/velnox' typecheck",
    "typecheck:packages": "bun --filter '@velnox/validation' typecheck && bun --filter '@velnox/api-contract' typecheck && bun --filter '@velnox/api-client' typecheck && bun --filter '@velnox/ledger' typecheck",
    "test:contracts": "bun test packages/*/tests",
    "test:ledger": "node --experimental-strip-types --test packages/ledger/tests/*.test.ts backend/tests/ledger-service.test.ts",
    "test:migrations": "node --experimental-strip-types --test database/tests/*.test.ts",
    "test:identity": "node --experimental-strip-types --test backend/tests/identity/*.test.ts",
    "test:commerce": "node --experimental-strip-types --test backend/tests/commerce/*.test.ts",
    "test:payment": "node --experimental-strip-types --test backend/tests/payment/*.test.ts",
    "test:realtime": "node --experimental-strip-types --test backend/tests/realtime/*.test.ts",
    "test:rebuild": "node --experimental-strip-types --test packages/ledger/tests/*.test.ts backend/tests/ledger-service.test.ts database/tests/*.test.ts backend/tests/identity/*.test.ts backend/tests/commerce/*.test.ts backend/tests/payment/*.test.ts backend/tests/realtime/*.test.ts",
    "i18n:check": "bun packages/shared/scripts/i18n-check.ts",
    "test": "bun test backend/tests",
    "lint": "eslint .",
    "format": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@iconify-json/lucide": "^1.2.152",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/tabler": "^1.2.43",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  }
}
