{
  "name": "velnox-marketplace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "backend"
  ],
  "scripts": {
    "dev:velshop": "bun --filter @velnox/velshop dev",
    "dev:velseller": "bun --filter @velnox/velseller dev",
    "dev:velcenter": "bun --filter @velnox/velcenter dev",
    "dev:velnox": "bun --filter @velnox/velnox dev",
    "build:velshop": "bun --filter @velnox/velshop build",
    "build:velseller": "bun --filter @velnox/velseller build",
    "build:velcenter": "bun --filter @velnox/velcenter build",
    "build:velnox": "bun --filter @velnox/velnox build",
    "build:apps": "bun --filter '@velnox/velshop' build && bun --filter '@velnox/velseller' build && bun --filter '@velnox/velcenter' build && bun --filter '@velnox/velnox' build",
    "api:dev": "bun --filter @velnox/backend dev",
    "api:start": "bun --filter @velnox/backend start",
    "db:migrate": "echo 'LEGACY ONLY: pre-MVP migrations in db/migrations/ are frozen. The MVP database is built from db/mvp/schema.sql — see db/mvp/cutover.md'",
    "db:verify": "bash db/verify-reconciler.sh",
    "db:verify:mvp": "bash db/mvp/verify.sh",
    "db:reset": "bash db/mvp/reset.sh",
    "db:smoke": "echo 'DB smoke test placeholder'",
    "db:consistency": "echo 'DB consistency check placeholder'",
    "typecheck": "bun --filter '@velnox/velshop' typecheck && bun --filter '@velnox/velseller' typecheck && bun --filter '@velnox/velcenter' typecheck && bun --filter '@velnox/velnox' typecheck",
    "i18n:check": "bun packages/shared/scripts/i18n-check.ts",
    "test": "bun test backend/tests",
    "test:mvp": "bash db/mvp/test-run.sh",
    "test:mvp:browser": "bash db/mvp/browser-e2e.sh",
    "lint": "echo 'Lint not yet configured'",
    "format": "echo 'Format not yet configured'"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "typescript": "~5.9.3"
  }
}
