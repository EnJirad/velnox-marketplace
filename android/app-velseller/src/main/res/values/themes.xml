<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VelSeller" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/velnox_primary</item>
        <item name="colorPrimaryVariant">@color/velnox_primary_variant</item>
        <item name="colorOnPrimary">@color/velnox_on_primary</item>

        <item name="colorSecondary">@color/velnox_secondary</item>
        <item name="colorSecondaryVariant">@color/velnox_secondary_variant</item>
        <item name="colorOnSecondary">@color/velnox_on_secondary</item>

        <item name="colorTertiary">@color/velnox_tertiary</item>
        <item name="colorTertiaryVariant">@color/velnox_tertiary_variant</item>
        <item name="colorOnTertiary">@color/velnox_on_tertiary</item>

        <item name="colorError">@color/velnox_error</item>
        <item name="colorOnError">@color/velnox_on_error</item>

        <item name="colorSurface">@color/velnox_surface</item>
        <item name="colorOnSurface">@color/velnox_on_surface</item>

        <item name="android:colorBackground">@color/velnox_background</item>
        <item name="colorOnBackground">@color/velnox_on_background</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.VelSeller.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.VelSeller.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.VelSeller.LargeComponent</item>
    </style>

    <style name="ShapeAppearance.VelSeller.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">7dp</item>
    </style>

    <style name="ShapeAppearance.VelSeller.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <style name="ShapeAppearance.VelSeller.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>

    <style name="Theme.VelSeller.Splash" parent="Theme.VelSeller">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
