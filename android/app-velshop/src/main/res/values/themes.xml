<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme for VelShop -->
    <style name="Theme.VelShop" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color (Dark slate) -->
        <item name="colorPrimary">@color/velnox_primary</item>
        <item name="colorPrimaryVariant">@color/velnox_primary_variant</item>
        <item name="colorOnPrimary">@color/velnox_on_primary</item>

        <!-- Secondary brand color (Emerald) -->
        <item name="colorSecondary">@color/velnox_secondary</item>
        <item name="colorSecondaryVariant">@color/velnox_secondary_variant</item>
        <item name="colorOnSecondary">@color/velnox_on_secondary</item>

        <!-- Tertiary brand color (Info blue) -->
        <item name="colorTertiary">@color/velnox_tertiary</item>
        <item name="colorTertiaryVariant">@color/velnox_tertiary_variant</item>
        <item name="colorOnTertiary">@color/velnox_on_tertiary</item>

        <!-- Error color (Red) -->
        <item name="colorError">@color/velnox_error</item>
        <item name="colorOnError">@color/velnox_on_error</item>

        <!-- Surface colors -->
        <item name="colorSurface">@color/velnox_surface</item>
        <item name="colorOnSurface">@color/velnox_on_surface</item>

        <!-- Background -->
        <item name="android:colorBackground">@color/velnox_background</item>
        <item name="colorOnBackground">@color/velnox_on_background</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Shape appearance -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.VelShop.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.VelShop.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.VelShop.LargeComponent</item>
    </style>

    <!-- Shape appearances for squircle-like corners -->
    <style name="ShapeAppearance.VelShop.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">7dp</item> <!-- Badge size -->
    </style>

    <style name="ShapeAppearance.VelShop.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item> <!-- Button/Input size -->
    </style>

    <style name="ShapeAppearance.VelShop.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item> <!-- Card size -->
    </style>

    <!-- Splash theme -->
    <style name="Theme.VelShop.Splash" parent="Theme.VelShop">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
